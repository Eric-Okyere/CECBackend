# Copy to .env for local development. On Render, set these under Environment.

# --- Required ---
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cec
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Google sign-in ---
GOOGLE_CLIENT_ID=450195054535-tbf14l0n9dhvjon1ili187agq5bcf89k.apps.googleusercontent.com

# --- Frontend ---
CLIENT_URL=https://cecextraclasses.netlify.app
# Comma-separated list of sites allowed to call this API from a browser
CORS_ORIGINS=https://cecextraclasses.netlify.app,http://localhost:5173

# --- Cloudinary (lesson videos) ---
CLOUD_NAME=
API_KEY=
API_SECRET=
MAX_VIDEO_MB=200

# --- Email (verification codes and password resets) via Resend ---
RESEND_API_KEY=
# Must use a domain you have verified in Resend
EMAIL_FROM=CEC Extra Classes <no-reply@your-verified-domain.com>
# Optional fallback for local development only (Gmail + App Password)
EMAIL_USER=
EMAIL_PASS=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
# Plan name -> price in GHS. Payments stay disabled until this is set.
PAYMENT_PLANS={"premium":50}

PORT=5001
